diff --git a/src/d3d9/d3d9_diag.h b/src/d3d9/d3d9_diag.h
new file mode 100644
index 0000000..20e4f07
--- /dev/null
+++ b/src/d3d9/d3d9_diag.h
@@ -0,0 +1,90 @@
+#pragma once
+
+// brz diagnostic build: log each distinct thing the game asks D3D9 for, once.
+// Lines start with "D3D9-DIAG:" so they are easy to grep in <exe>_d3d9.log.
+
+#include <cstdint>
+#include <mutex>
+#include <string>
+#include <unordered_set>
+
+#include "../util/log/log.h"
+#include "../util/thread.h"
+#include "../util/util_string.h"
+
+namespace dxvk::diag {
+
+  enum Category : uint32_t {
+    Texture = 0,
+    FormatCheck,
+    DrawPath,
+    FixedFunctionVS,
+    FixedFunctionPS,
+    CategoryCount
+  };
+
+  // Builds and logs the message only the first time `key` is seen in `cat`.
+  // Each category is capped so a pathological game cannot flood the log.
+  template <typename Fn>
+  void once(Category cat, uint64_t key, Fn&& makeMessage, size_t limit = 400) {
+    static dxvk::mutex mutex;
+    static std::unordered_set<uint64_t> seen[CategoryCount];
+
+    {
+      std::lock_guard<dxvk::mutex> lock(mutex);
+      auto& set = seen[cat];
+      if (set.size() >= limit || !set.insert(key).second)
+        return;
+      if (set.size() == limit)
+        Logger::info(str::format("D3D9-DIAG: category ", uint32_t(cat), " reached ", limit, " entries, no more logged"));
+    }
+
+    Logger::info(str::format("D3D9-DIAG: ", makeMessage()));
+  }
+
+  inline uint64_t mix(uint64_t h, uint64_t v) {
+    return (h ^ (v + 0x9e3779b97f4a7c15ull + (h << 6) + (h >> 2))) * 0x100000001b3ull;
+  }
+
+  inline const char* topName(uint32_t op) {
+    static const char* names[] = { "?", "DISABLE", "SELECTARG1", "SELECTARG2", "MODULATE", "MODULATE2X",
+      "MODULATE4X", "ADD", "ADDSIGNED", "ADDSIGNED2X", "SUBTRACT", "ADDSMOOTH", "BLENDDIFFUSEALPHA",
+      "BLENDTEXTUREALPHA", "BLENDFACTORALPHA", "BLENDTEXTUREALPHAPM", "BLENDCURRENTALPHA", "PREMODULATE",
+      "MODULATEALPHA_ADDCOLOR", "MODULATECOLOR_ADDALPHA", "MODULATEINVALPHA_ADDCOLOR",
+      "MODULATEINVCOLOR_ADDALPHA", "BUMPENVMAP", "BUMPENVMAPLUMINANCE", "DOTPRODUCT3", "MULTIPLYADD", "LERP" };
+    return op < sizeof(names) / sizeof(names[0]) ? names[op] : "?";
+  }
+
+  inline std::string taName(uint32_t arg) {
+    static const char* names[] = { "DIFFUSE", "CURRENT", "TEXTURE", "TFACTOR", "SPECULAR", "TEMP", "CONSTANT" };
+    std::string s = (arg & 0xf) < 7 ? names[arg & 0xf] : "?";
+    if (arg & 0x10) s = "1-" + s;      // D3DTA_COMPLEMENT
+    if (arg & 0x20) s += ".aaaa";      // D3DTA_ALPHAREPLICATE
+    return s;
+  }
+
+  inline const char* poolName(uint32_t pool) {
+    switch (pool) {
+      case 0: return "DEFAULT";
+      case 1: return "MANAGED";
+      case 2: return "SYSTEMMEM";
+      case 3: return "SCRATCH";
+      case 6: return "MANAGED_EX";
+      default: return "?";
+    }
+  }
+
+  inline const char* rtypeName(uint32_t type) {
+    switch (type) {
+      case 1: return "SURFACE";
+      case 2: return "VOLUME";
+      case 3: return "TEXTURE";
+      case 4: return "VOLUMETEXTURE";
+      case 5: return "CUBETEXTURE";
+      case 6: return "VERTEXBUFFER";
+      case 7: return "INDEXBUFFER";
+      default: return "?";
+    }
+  }
+
+}
